{
  "theme": {
    "mode": "system",
    "dark": "Xyra Dark",
    "light": "Xyra Light"
  },
  "base_keymap": "Cursor",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "cursor_shape": "block",
  "cursor_blink": false,
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/.next",
    "**/dist",
    "**/build",
    "**/target",
    "**/.turbo",
    "**/.venv",
    "**/__pycache__",
    "**/.pnpm-store"
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "blinking": "off"
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  "edit_predictions": {
    "mode": "eager"
  },
  "agent": {
    "dock": "right",
    "default_width": 480,
    "button": true,
    "play_sound_when_agent_done": "when_hidden",
    "notify_when_agent_waiting": "primary_screen",
    "expand_edit_card": true,
    "expand_terminal_card": true,
    "profiles": {
      "explore": {
        "name": "Explore",
        "tools": {
          "read_file": true,
          "grep": true,
          "find_path": true,
          "list_directory": true,
          "find_references": true,
          "go_to_definition": true,
          "get_code_actions": true,
          "diagnostics": true,
          "fetch": true,
          "web_search": true,
          "skill": true,
          "list_agents_and_models": true
        },
        "enable_all_context_servers": true,
        "default_model": {
          "provider": "ollama",
          "model": "hf.co/bartowski/mlabonne_gemma-3-27b-it-abliterated-GGUF:Q6_K"
        }
      },
      "review": {
        "name": "Review",
        "tools": {
          "read_file": true,
          "grep": true,
          "find_path": true,
          "list_directory": true,
          "find_references": true,
          "go_to_definition": true,
          "get_code_actions": true,
          "diagnostics": true,
          "skill": true
        },
        "enable_all_context_servers": false,
        "default_model": {
          "provider": "ollama",
          "model": "qwen2.5-coder:32b"
        }
      }
    },
    "subagent_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:32b"
    },
    "thread_summary_model": {
      "provider": "ollama",
      "model": "hf.co/bartowski/mlabonne_gemma-3-27b-it-abliterated-GGUF:Q6_K"
    },
    "inline_assistant_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:32b"
    },
    "commit_message_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:32b"
    },
    "single_file_review": false
  },
  "agent_servers": {
    "Grok Build": {
      "type": "custom",
      "command": "/opt/homebrew/bin/grok",
      "args": [
        "agent",
        "stdio"
      ],
      "env": {}
    },
    "Claude Code": {
      "type": "custom",
      "command": "npx",
      "args": [
        "-y",
        "@zed-industries/claude-code-acp"
      ],
      "env": {}
    }
  }
}
