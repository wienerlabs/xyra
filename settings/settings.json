{
  "theme": {
    "mode": "system",
    "dark": "Xyra Dark",
    "light": "Xyra Light"
  },
  "base_keymap": "Cursor",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "cursor_shape": "block",
  "cursor_blink": false,
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/.next",
    "**/dist",
    "**/build",
    "**/target",
    "**/.turbo",
    "**/.venv",
    "**/__pycache__",
    "**/.pnpm-store"
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "blinking": "off"
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  "edit_predictions": {
    "mode": "eager"
  },
  "agent": {
    "dock": "right",
    "default_width": 480,
    "button": true,
    "play_sound_when_agent_done": "when_hidden",
    "notify_when_agent_waiting": "primary_screen",
    "expand_edit_card": true,
    "expand_terminal_card": true
  },
  "agent_servers": {
    "Grok Build": {
      "type": "custom",
      "command": "/opt/homebrew/bin/grok",
      "args": [
        "agent",
        "stdio"
      ],
      "env": {}
    },
    "Claude Code": {
      "type": "custom",
      "command": "npx",
      "args": [
        "-y",
        "@zed-industries/claude-code-acp"
      ],
      "env": {}
    }
  }
}
