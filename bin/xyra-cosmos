#!/usr/bin/env bash
set -uo pipefail

BUILDER="grok"
REVIEWER="claude"
EXECUTE=0

usage() {
  cat >&2 <<EOF
xyra-cosmos: proje seviyesinde Konsey. Bir vendor design doc yazar, rakip vendor challenge eder,
çıktı repoya gömülür. İsteğe bağlı olarak ticket'lar Konsey ile implemente edilir.

Kullanım: xyra-cosmos [--by grok|claude] [--review grok|claude] [--execute] "proje hedefi"
  --by       design'ı yazan agent (varsayılan: grok)
  --review   design'ı challenge eden rakip (varsayılan: claude)
  --execute  onaylı design'daki ticket'ları Konsey ile uygula (deneysel)
EOF
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --by) BUILDER="$2"; shift 2 ;;
    --review) REVIEWER="$2"; shift 2 ;;
    --execute) EXECUTE=1; shift ;;
    -h|--help) usage ;;
    *) break ;;
  esac
done

OBJECTIVE="${*:-}"
[ -n "$OBJECTIVE" ] || usage
[ "$BUILDER" != "$REVIEWER" ] || { echo "yazan ve challenge eden aynı vendor olamaz" >&2; exit 1; }

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT" || exit 1
SLUG="$(printf '%s' "$OBJECTIVE" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-' | cut -c1-48)"
STAMP="$(date +%Y%m%d-%H%M)"
DOCDIR="$ROOT/docs/cosmos"
DOC="$DOCDIR/$STAMP-$SLUG.md"
mkdir -p "$DOCDIR"

run_agent() {
  case "$1" in
    grok)   grok --minimal --disable-web-search -p "$2" 2>/dev/null ;;
    claude) claude -p "$2" 2>/dev/null ;;
    *) echo "bilinmeyen vendor: $1" >&2; return 1 ;;
  esac
}

CTX=""
if command -v xyra-context >/dev/null 2>&1; then
  xyra-context index "$ROOT" >/dev/null 2>&1 || true
  CTX="$(xyra-context search "$ROOT" "$OBJECTIVE" 2>/dev/null | head -80)"
fi

DESIGN_PROMPT="You are a staff engineer. Produce a concise design doc for this objective, grounded in the ACTUAL codebase paths below. Do not write code. Sections in this exact order:
# Goal
# Affected components (real file paths)
# Approach
# Rollout and risks
# Testing
# Tickets (dependency-ordered; each: number, title, scope, files, depends-on)

Objective: $OBJECTIVE

Relevant code context:
$CTX"

echo "== Cosmos: $BUILDER design taslağı yazıyor =="
DRAFT="$(run_agent "$BUILDER" "$DESIGN_PROMPT")"

echo "== $REVIEWER (rakip vendor) design'ı challenge ediyor =="
CHALLENGE="$(run_agent "$REVIEWER" "You are a skeptical principal engineer from a rival AI vendor. Challenge this design doc hard: hidden risks, missing components, a simpler alternative, wrong ticket ordering or dependencies, scope creep, and money/Solana safety (integer units, address poisoning). Be specific and terse.

Design doc:
$DRAFT")"

echo "== $BUILDER geçerli itirazlarla design'ı sonlandırıyor =="
FINAL="$(run_agent "$BUILDER" "Incorporate the valid challenges into a final design doc, ignore the noise. Keep the exact section structure (Goal, Affected components, Approach, Rollout and risks, Testing, Tickets). Objective: $OBJECTIVE

Your draft:
$DRAFT

Rival challenge:
$CHALLENGE")"

{
  echo "# Cosmos design: $OBJECTIVE"
  echo
  echo "> $BUILDER wrote, $REVIEWER challenged, $BUILDER finalized. Review before executing."
  echo
  echo "$FINAL"
  echo
  echo "---"
  echo "## Rival challenge (for the record)"
  echo
  echo "$CHALLENGE"
} > "$DOC"

echo ""
echo "Design doc hazır: $DOC"
echo "İncele, gerekirse düzenle. Uygulamak için: xyra-cosmos --execute \"$OBJECTIVE\"  (veya ticket başına: xyra-council \"<ticket>\")"

if [ "$EXECUTE" -eq 1 ]; then
  command -v xyra-council >/dev/null 2>&1 || { echo "xyra-council gerekli" >&2; exit 1; }
  echo ""
  echo "== Ticket'lar Konsey ile uygulanıyor (deneysel) =="
  echo "UYARI: bu working tree'yi değiştirir. Her ticket sonrası git diff ile incele."
  grep -nE "^[0-9]+\.|^- \[|^#### Ticket|^\*\*[0-9]" "$DOC" | head -20
  echo ""
  echo "Otomatik ticket ayrıştırma LLM biçimine göre kırılgan; şimdilik her ticket'ı elle çalıştır:"
  echo "  xyra-council --by $BUILDER --review $REVIEWER \"<ticket metni>\""
fi
